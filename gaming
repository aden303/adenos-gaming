            </a>

            <a class="game-card" href="https://html5.gamedistribution.com/rvvASMiM/a87a2a7071254bf6b4b476e3366c303f/" target="_blank">
                <div class="game-thumb">⚔️</div>
                <div class="game-info">
                    <div class="game-title">Stickman Battle</div>
                    <div class="game-cat">SAVAŞ</div>
                </div>
            </a>

            <a class="game-card" href="https://games.gamedistribution.com/f201083416e94efca5f3b769f3792019/" target="_blank">
                <div class="game-thumb">🧟</div>
                <div class="game-info">
                    <div class="game-title">Zombie Apocalypse</div>
                    <div class="game-cat">AKSİYON</div>
                </div>
            </a>

            <a class="game-card" href="https://html5.gamedistribution.com/rvvASMiM/1e7b264b971542fca14c776856a93d25/" target="_blank">
                <div class="game-thumb">✈️</div>
                <div class="game-info">
                    <div class="game-title">Air Jet Combat</div>
                    <div class="game-cat">SAVAŞ</div>
                </div>
            </a>
        </div>
    </div>
</body>
</html>
